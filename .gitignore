# ============ 运行时产物，不纳入版本控制 ============
# 引擎 MSI：单个约 247 MB，体积过大且可随时从 GitHub 重新下载
downloads/
*.msi

# 运行日志：属运行时产物，且含主机名与本机路径，不应公开
wsl-autoupdate.log
wsl-autoupdate.log.*

# msiexec 安装日志
install-*.log

# ============ 临时/测试脚本 ============
# 以 _ 开头的临时验证脚本不进仓库
_*.ps1

# ============ 本机部署设置 ============
# settings.psd1 存的是本机专属路径（如备份目录），不应提交。
# 仓库里保留 settings.example.psd1 作为模板。
settings.psd1
